{
  "name": "maali-civil-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "figures": "tsx scripts/export-figures.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/db.ts migrate",
    "db:seed": "tsx --env-file=.env.local scripts/db.ts seed",
    "db:status": "tsx --env-file=.env.local scripts/db.ts status",
    "db:clear": "tsx --env-file=.env.local scripts/db.ts clear",
    "db:admin": "tsx --env-file=.env.local scripts/db.ts admin"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
